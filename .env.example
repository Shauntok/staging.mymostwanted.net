# Server-only keys will be configured by the user for each isolated environment.
# Never put production secrets here or commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false in Development and Staging; enable only after Production launch review.
ALLOW_SEARCH_INDEXING=false
# NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase publishable key in client-visible configuration; RLS still applies.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use a Supabase secret key only on the server; it bypasses RLS.
# SUPABASE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
