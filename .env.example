# Server-only keys will be configured by the user for each isolated environment.
# Never put production secrets here or commit real credentials.
# NODE_ENV and VERCEL_ENV are provided by the runtime platform; do not use this file to override them.
# Local isolated-build helper only: set MMWR_VALIDATION_DIST_DIR=.next-validation temporarily; never use it as a shared deployment setting.
# MMWR_VALIDATION_DIST_DIR=.next-validation
# Local-only Supabase tests: MMWR_TEST_LOCAL_STORAGE_RESTORE=true and MMWR_TEST_LOCAL_THUMBNAIL_DELIVERY=true each use a unique synthetic private Storage bucket; MMWR_TEST_LOCAL_THUMBNAIL_DATABASE=true performs read-only checks against the default-OFF local database gate. MMWR_TEST_LOCAL_DATABASE_RESTORE=true requires a fresh disposable Supabase project whose ID is provided in MMWR_TEST_LOCAL_DATABASE_RESTORE_PROJECT_REF and matches mmwrrestoretarget plus three alphanumeric characters; the test writes synthetic SQL to that project's DB volume. Discard that target stack and volume after the test, especially after failure. Never set these test variables for deployment.
# MMWR_TEST_CLAMD_PORT=3310
# MMWR_TEST_REAL_CLAMD=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Appeals, corrections, and takedown requests remain closed pending policy confirmation.
# Owner IP blocks stay disabled until a trusted ingress replaces one supported client-IP header and all values are verified in Staging.
MMWR_IP_BLOCK_ENABLED=false
# Dedicated per-environment secret, at least 32 bytes. Keep stable while active blocks exist; never expose it to the browser.
# The direct Data API guard also needs the exact same value stored in Supabase Vault as mmwr_ip_block_hmac_secret.
# MMWR_IP_BLOCK_HMAC_SECRET=
# Supported: x-vercel-forwarded-for, cf-connecting-ip, x-mmwr-client-ip. Leave unset until the ingress is confirmed to overwrite it.
# If enabled later, Supabase authenticator setting app.settings.mmwr_ip_block_trusted_client_ip_header must use this exact value.
# MMWR_IP_BLOCK_TRUSTED_CLIENT_IP_HEADER=
# Keep false in Development and Staging; enable only after Production launch review.
ALLOW_SEARCH_INDEXING=false
# Keep both gates OFF until the UI is accepted and the synthetic database,
# evidence-ownership and Auth-session checks pass in an isolated environment.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_CLEANUP_ENABLED=false
# NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase publishable key in client-visible configuration; RLS still applies.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use a Supabase secret key only on the server; it bypasses RLS.
# Server-side one-shot workers use the matching non-public project URL.
# SUPABASE_URL=
  # Required by privileged server-side report writes and by the Owner IP block check when MMWR_IP_BLOCK_ENABLED=true.
# SUPABASE_SECRET_KEY=
# HMAC key for search and public-thumbnail rate-limit identifiers (purpose-separated); generate separately per environment.
# SEARCH_RATE_LIMIT_HMAC_SECRET=
# Must name an ingress-verified client IP header. Validate the selected header against the actual proxy in Staging; both limits fail closed while unset.
# SEARCH_TRUSTED_CLIENT_IP_HEADER=
# Public Turnstile site key. Login, signup, password reset and report submissions fail closed without both keys and a valid HTTPS site URL.
# Supabase Auth also validates login, signup and password-reset tokens directly; configure this same secret in local Auth config and each hosted Auth environment.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# GA4 can create visitor/session metrics; keep it disabled until separately approved.
NEXT_PUBLIC_GA4_ENABLED=false
# Optional GA4 Measurement ID. The ID alone never enables collection.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# First-party daily page-view aggregates remain OFF until data/API configuration is verified.
FIRST_PARTY_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FIRST_PARTY_ANALYTICS_ENABLED=false
VALID_READS_ENABLED=false
NEXT_PUBLIC_VALID_READS_ENABLED=false
HOT_RANKING_ENABLED=false
ANALYTICS_VALID_READ_HMAC_SECRET=
# Separate per-environment HMAC secret; only its short-lived digest is stored for rate limiting.
# ANALYTICS_RATE_LIMIT_HMAC_SECRET=
# Must name an ingress-verified client IP header. Leave unset until the Vercel/Cloudflare path is verified.
# ANALYTICS_TRUSTED_CLIENT_IP_HEADER=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
MMWR_BACKUP_ENABLED=false
# Database restore coordinator is a separate destructive-operation gate; keep OFF outside disposable isolated drills.
MMWR_BACKUP_RESTORE_ENABLED=false
# Opt-in integration test target label; use only with a fresh disposable Supabase project such as mmwrrestoretarget001.
# MMWR_TEST_LOCAL_DATABASE_RESTORE=false
# MMWR_TEST_LOCAL_DATABASE_RESTORE_PROJECT_REF=
# Optional full local DB + Storage restore drill; requires a fresh disposable Supabase stack matching the project-ref label.
# Keep URLs, Secret Keys, and database passwords in the invoking process environment only; do not put credentials in this file.
# MMWR_TEST_LOCAL_FULL_RESTORE=false
# MMWR_TEST_LOCAL_FULL_RESTORE_PROJECT_REF=mmwrrestoretarget001
# MMWR_TEST_LOCAL_FULL_RESTORE_SOURCE_URL=
# MMWR_TEST_LOCAL_FULL_RESTORE_SOURCE_SECRET_KEY=
# MMWR_TEST_LOCAL_FULL_RESTORE_SOURCE_DATABASE_URL=
# MMWR_TEST_LOCAL_FULL_RESTORE_SOURCE_DATABASE_PASSWORD=
# MMWR_TEST_LOCAL_FULL_RESTORE_SOURCE_CONTAINER=supabase_db_mmwr
# MMWR_TEST_LOCAL_FULL_RESTORE_TARGET_URL=
# MMWR_TEST_LOCAL_FULL_RESTORE_TARGET_SECRET_KEY=
# Per-object Storage backup byte cap; raise only after checking worker disk and memory budgets.
MMWR_BACKUP_MAX_STORAGE_OBJECT_BYTES=10485760
# Optional executable overrides for local backup/restore CLI invocations. Usually leave unset and use PATH defaults.
# DOCKER_PATH=docker
# PSQL_PATH=psql
# Required before enabling: maximum combined listed Storage source bytes for one run.
# This is not a temporary-workspace cap; encryption/readback need additional disk capacity.
# MMWR_BACKUP_MAX_TOTAL_STORAGE_BYTES=
# Supabase DB connection string is consumed only by the isolated backup worker; never configure it in the Next.js web process.
# SUPABASE_DB_URL=
# Set to the source database's major version after confirming it from the Supabase project; manifest compatibility metadata only.
# MMWR_DATABASE_MAJOR_VERSION=
# Supply a PostgreSQL URL without a password; the password is passed to dump tools only as a child-process environment variable.
# SUPABASE_DB_PASSWORD=
# Optionally pin the Supabase CLI executable path in the worker image; pin the installed CLI version in that image.
# SUPABASE_CLI_PATH=
# Optionally pin pg_dump for the two explicitly allowlisted Auth/Storage migration-ledger tables; match the source server major version.
# PG_DUMP_PATH=
# Explicit calendar timezone for retention buckets; proposed value pending Owner confirmation.
# MMWR_BACKUP_TIME_ZONE=Asia/Kuala_Lumpur
# MMWR_BACKUP_ENCRYPTION_KEY=
# Private evidence scanning remains disabled until the migration and scanner runtime are configured and validated.
EVIDENCE_SCANNER_ENABLED=false
# Sanitized public thumbnails require the scanner, Owner approval and an independent database flag; keep disabled by default.
MMWR_PUBLIC_THUMBNAILS_ENABLED=false
# Staff-only evidence previews also require a disabled-by-default private database flag.
# Keep off until scanner migrations, MFA authorization, and short-lived URLs are verified in Staging.
STAFF_EVIDENCE_PREVIEW_ENABLED=false
OWNER_EVIDENCE_VISIBILITY_ENABLED=false
# Submission publication also requires an independent database runtime flag with no UI toggle.
MMWR_SUBMISSION_PUBLICATION_ENABLED=false
# Dedicated scanner bearer credential (at least 32 random bytes); never use SUPABASE_SECRET_KEY here.
# EVIDENCE_SCANNER_TOKEN=
# Critical security email remains disabled until Owner policy, SMTP, server flag and dedicated scheduler token are configured.
CRITICAL_SECURITY_EMAIL_ENABLED=false
# Dedicated dispatcher bearer token (at least 32 random bytes); never reuse scanner or Supabase credentials.
# CRITICAL_SECURITY_EMAIL_TOKEN=
# Scanner container settings (only configure when following the guided deployment steps).
# Pin both images to a trusted, versioned reference with an immutable sha256 digest; no floating defaults.
# CLAMD_HOST and CLAMD_PORT are wired internally by Compose to the private ClamAV service; do not expose or publish them.
# CLAMD_HOST=clamav
# CLAMD_PORT=3310
# MMWR_SCANNER_API_ORIGIN=https://your-mmwr-host.example
# MMWR_SUPABASE_STORAGE_ORIGIN=https://your-project.supabase.co
# CLAMAV_IMAGE=clamav/clamav:<version>@sha256:<verified-digest>
# NODE_BASE_IMAGE=node:22-alpine@sha256:<verified-digest>
# Optional official Telegram recipient for clarification request drafts only.
# Must be exactly https://t.me/<username>; leave blank until the Owner supplies the official account.
PUBLIC_TELEGRAM_SUPPORT_URL=
