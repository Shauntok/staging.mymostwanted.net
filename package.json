{
  "name": "mmwr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:smoke": "node scripts/security/production-smoke.mjs",
    "test": "npm run test:backup && npm run test:public-pagination && npm run test:public-post-grid && npm run test:public-thumbnails && npm run test:admin-storage-usage && npm run test:analytics-consent && npm run test:analytics-route-policy && npm run test:report-envelope && npm run test:report-share && npm run test:report-submit && npm run test:submission-social-links && npm run test:share-targets && npm run test:seo && npm run test:auth-form-props && npm run test:email-verification-resend && npm run test:staff-session && npm run test:staff-session-request && npm run test:turnstile && npm run test:maps && npm run test:tags && npm run test:scanner && npm run test:account-deletion && npm run test:search-layout && npm run test:home-quota && npm run check:runtime-env-example && npm run check:migration-rollback-coverage && npm run test:api-schema-exposure",
    "test:db": "supabase test db --local",
    "test:local": "npm test && npm run test:db && supabase db lint --local",
    "test:backup": "node --test backup/*.test.mjs",
    "test:public-pagination": "node --test lib/public-pagination.test.mjs",
    "test:public-post-grid": "node --test components/public-posts/*.test.mjs",
    "test:public-thumbnails": "node --test lib/public-thumbnails/*.test.mjs",
    "test:admin-storage-usage": "node --test lib/admin/storage-usage.test.mjs",
    "test:analytics-consent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/analytics/consent-attestation.test.mjs",
    "test:analytics-route-policy": "node --test lib/analytics/route-policy.test.mjs",
    "test:report-envelope": "node --test lib/reports/request-envelope.test.mjs",
    "test:report-share": "node --test lib/reports/share-origin.test.mjs",
    "test:report-submit": "node --test lib/reports/submit.test.mjs",
    "test:submission-social-links": "node --test lib/submissions/social-links.test.mjs",
    "test:share-targets": "node --test lib/public-share-targets.test.mjs",
    "test:seo": "node --test lib/seo/*.test.mjs",
    "test:auth-form-props": "node --test lib/auth/account-auth-form-props.test.mjs",
    "test:email-verification-resend": "node --test lib/auth/email-verification-resend.test.mjs",
    "test:staff-session": "node --test lib/admin/staff-session-claims.test.mjs",
    "test:staff-session-request": "node --test lib/admin/staff-session-request.test.mjs",
    "test:turnstile": "node --test lib/security/turnstile.test.mjs",
    "test:maps": "node --test components/maps/*.test.mjs components/areas/*.test.mjs",
    "test:tags": "node --test components/tags/*.test.mjs",
    "test:search-layout": "node --test components/search/*.test.mjs",
    "test:home-quota": "node --test lib/home-quota.test.mjs",
    "test:scanner": "node --test scanner/*.test.mjs",
    "test:account-deletion": "node --test account-deletion/*.test.mjs",
    "check:migration-rollback-coverage": "node scripts/check-migration-rollback-coverage.mjs",
    "check:runtime-env-example": "node scripts/runtime-env-coverage.mjs",
    "test:api-schema-exposure": "node --test scripts/supabase-api-schemas.test.mjs",
    "backup:once": "node backup/run-scheduled.mjs",
    "account-deletion:once": "node account-deletion/run-scheduled.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "nodemailer": "10.0.11",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
